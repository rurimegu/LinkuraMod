<Project Sdk="Godot.NET.Sdk/4.5.1">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>RuriMegu</RootNamespace>
    <Version>0.2.6.0</Version>
    <GameApiVersion Condition="'$(GameApiVersion)' == ''">0.107.1</GameApiVersion>
    <Sts2AssemblyPath Condition="'$(Sts2AssemblyPath)' == ''">libs\sts2.dll</Sts2AssemblyPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Sts2Core">
      <HintPath>$(Sts2AssemblyPath)</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="STS2.RitsuLib.Compat.0.107.1" Version="[0.6.2,)" Condition="'$(GameApiVersion)' == '0.107.1'">
      <ExcludeAssets>runtime</ExcludeAssets>
      <Private>False</Private>
    </PackageReference>
    <PackageReference Include="STS2.RitsuLib" Version="[0.6.2,)" Condition="'$(GameApiVersion)' == '0.111.0'">
      <ExcludeAssets>runtime</ExcludeAssets>
      <Private>False</Private>
    </PackageReference>
    <PackageReference Include="STS2.ModAnalyzers.RitsuLib" Version="*" PrivateAssets="all" />
    <PackageReference Include="Lib.Harmony" Version="2.*" />
  </ItemGroup>
  <ItemGroup>
    <AdditionalFiles Include="mod_manifest.json" />
    <AdditionalFiles Include="LinkuraMod/localization/**/*.json" />
  </ItemGroup>
  <Target Name="ValidateGameApiVersion" BeforeTargets="Restore;ResolveReferences">
    <Error Condition="'$(GameApiVersion)' != '0.107.1' and '$(GameApiVersion)' != '0.111.0'" Text="GameApiVersion must be 0.107.1 or 0.111.0." />
    <Error Condition="!Exists('$(Sts2AssemblyPath)')" Text="Sts2AssemblyPath does not exist: $(Sts2AssemblyPath)" />
  </Target>
</Project>
